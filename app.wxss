/* ===== 设计令牌 ===== */
page { --bg: #f1f5f9; --card: #fff; --text: #0f172a; --text-2: #64748b; --text-3: #94a3b8;
  --border: #e2e8f0; --primary: #4f46e5; --primary-light: #eef2ff;
  --success: #10b981; --success-light: #d1fae5;
  --warning: #f59e0b; --warning-light: #fef3c7;
  --danger: #ef4444; --danger-light: #fee2e2;
  --radius: 16rpx; --radius-lg: 24rpx;
  background: var(--bg); font-size: 28rpx; color: var(--text); font-family: -apple-system, BlinkMacSystemFont, sans-serif;
  box-sizing: border-box; min-height: 100vh; padding-bottom: 140rpx; }

/* ===== 通用样式 ===== */
.card { background: var(--card); border-radius: var(--radius-lg); padding: 28rpx; margin: 0 24rpx 20rpx; box-shadow: 0 2rpx 12rpx rgba(15,23,42,.04); }
.search-bar { margin: 20rpx 24rpx; display: flex; align-items: center; background: var(--card); border-radius: 40rpx; padding: 16rpx 28rpx; box-shadow: 0 2rpx 8rpx rgba(15,23,42,.04); }
.search-bar input { flex:1; font-size:28rpx; border:none; outline:none; background:transparent; }
.search-ico { font-size: 32rpx; margin-right: 12rpx; flex-shrink:0; }

.btn { display:inline-flex; align-items:center; justify-content:center; padding:16rpx 28rpx; border-radius:40rpx; font-size:28rpx; font-weight:600; border:none; transition:opacity .2s; box-sizing:border-box; overflow:hidden; }
.btn:active { opacity:.8; }
.btn-primary { background: var(--primary); color: #fff; }
.btn-success { background: var(--success); color: #fff; }
.btn-warning { background: var(--warning); color: #fff; }
.btn-danger { background: var(--danger); color: #fff; }
.btn-outline { background:transparent; border:2rpx solid var(--border); color:var(--text); }
.btn-sm { padding: 10rpx 24rpx; font-size: 24rpx; }
.btn-block { display:flex; width:100%; }
.btn-lg { padding:0 32rpx; height:88rpx; line-height:88rpx; font-size:30rpx; border-radius:44rpx; }

.tag { display:inline-block; padding:4rpx 16rpx; border-radius:8rpx; font-size:22rpx; font-weight:600; }
.tag-pending { background:var(--warning-light); color:var(--warning); }
.tag-accepted { background:#dbeafe; color:#3b82f6; }
.tag-shipped { background:#ede9fe; color:#8b5cf6; }
.tag-partial { background:#cffafe; color:#0891b2; }
.tag-received { background:var(--success-light); color:var(--success); }
.tag-cancelled { background:#f3f4f6; color:#9ca3af; }
.tag-active { background:var(--success-light); color:var(--success); }
.tag-stale { border:2rpx solid #fbbf24; }

.empty-block { padding:100rpx 0; text-align:center; color:var(--text-3); }
.empty-block .empty-ico { font-size:80rpx; margin-bottom:16rpx; }

/* category filter */
.cat-bar { display:flex; flex-wrap:nowrap; overflow-x:auto; white-space:nowrap; padding: 8rpx 24rpx 16rpx; gap:12rpx; }
.cat-bar::-webkit-scrollbar { display:none; }
.cat-tag { display:inline-flex; align-items:center; padding:10rpx 24rpx; border-radius:40rpx; font-size:26rpx; background:var(--card); color:var(--text-2); white-space:nowrap; flex-shrink:0; box-shadow:0 1rpx 4rpx rgba(15,23,42,.04); }
.cat-tag.active { background:var(--primary); color:#fff; }

/* goods item */
.goods-item { display:flex; align-items:center; padding:24rpx 0; border-bottom:1rpx solid var(--border); }
.goods-item:last-child { border-bottom:none; }
.goods-avatar { width:80rpx; height:80rpx; border-radius:16rpx; display:flex; align-items:center; justify-content:center; font-size:40rpx; margin-right:20rpx; flex-shrink:0; background:var(--bg); }
.goods-info { flex:1; overflow:hidden; }
.goods-name { font-size:30rpx; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.goods-meta { font-size:24rpx; color:var(--text-2); margin-top:4rpx; }
.goods-price { font-size:30rpx; font-weight:700; color:var(--danger); margin-left:16rpx; }

/* form */
.form-group { margin-bottom:28rpx; }
.form-label { font-size:26rpx; color:var(--text-2); margin-bottom:10rpx; display:block; }
.form-input { width:100%; height:80rpx; border:2rpx solid var(--border); border-radius:var(--radius); padding:0 20rpx; font-size:28rpx; box-sizing:border-box; background:var(--card); }
.form-input:focus { border-color:var(--primary); }
.form-textarea { width:100%; min-height:120rpx; border:2rpx solid var(--border); border-radius:var(--radius); padding:16rpx 20rpx; font-size:28rpx; box-sizing:border-box; background:var(--card); }

/* modal */
.modal-mask { position:fixed; top:0;left:0;right:0;bottom:0; background:rgba(0,0,0,.45); z-index:1000; display:flex; align-items:center; justify-content:center; }
.modal-overlay { position:absolute; top:0;left:0;right:0;bottom:0; z-index:0; }
.modal-body { position:relative; z-index:1; background:#fff; border-radius:var(--radius-lg); width:600rpx; max-width:90vw; max-height:80vh; overflow-y:auto; padding:36rpx; box-sizing:border-box; }
.modal-title { font-size:34rpx; font-weight:700; margin-bottom:24rpx; text-align:center; }
.modal-actions { display:flex; gap:16rpx; margin-top:28rpx; }
.modal-actions .btn { flex:1; min-width:0; }

/* stat highlight */
.stat-row { display:flex; margin:0 -8rpx; }
.stat-cell { flex:1; text-align:center; padding:16rpx 8rpx; }
.stat-num { font-size:44rpx; font-weight:800; }
.stat-label { font-size:24rpx; color:var(--text-2); margin-top:4rpx; }

/* role color overrides */
.admin-theme { --role-color: #4f46e5; --role-light: #eef2ff; }
.manager-theme { --role-color: #0f766e; --role-light: #f0fdfa; }
.supplier-theme { --role-color: #ea580c; --role-light: #fff7ed; }

/* 导航栏占位 */
.fix-top { padding-top:20rpx; }

/* 滚动列表安全区 */
.scroll-body { padding-bottom:40rpx; }

/* 分页加载 */
.load-more { text-align: center; padding: 20rpx 0 40rpx; font-size: 24rpx; color: var(--text-3); }
.load-end { color: var(--text-3); opacity: 0.6; }
