.tabbar { position:fixed; bottom:0; left:0; right:0; display:flex; background:rgba(255,255,255,.95); backdrop-filter:saturate(180%) blur(10rpx); border-top:1rpx solid #e2e8f0; z-index:999; padding:8rpx 0; padding-bottom:calc(8rpx + env(safe-area-inset-bottom)); }
.tab-item { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:6rpx 0; transition:opacity .2s; }
.tab-item:active { opacity:.7; }
.tab-icon-wrap { position:relative; display:inline-block; }
.tab-icon { font-size:40rpx; margin-bottom:2rpx; }
.tab-label { font-size:20rpx; color:#94a3b8; }
.tab-item.active .tab-label { font-weight:600; color:#0f172a; }

/* 红点 */
.tab-badge {
  position:absolute; top:-4rpx; right:-10rpx;
  min-width:28rpx; height:28rpx; line-height:28rpx;
  border-radius:14rpx; background:#ef4444; color:#fff;
  font-size:18rpx; text-align:center; padding:0 6rpx;
  box-shadow:0 1rpx 3rpx rgba(239,68,68,.4);
}
