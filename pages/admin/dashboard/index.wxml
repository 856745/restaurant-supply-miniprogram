<view class="fix-top"></view>

<!-- 标题栏 -->
<view class="card" style="background:linear-gradient(135deg,#4f46e5,#6366f1);color:#fff;border-radius:24rpx;">
  <view style="font-size:36rpx;font-weight:700;">餐饮供货 · 管理后台</view>
  <view style="font-size:24rpx;opacity:.8;margin-top:8rpx;">全局数据总览与系统管控</view>
</view>

<!-- 统计卡片 -->
<view class="stat-row card">
  <view class="stat-cell" bindtap="goTo" data-url="/pages/admin/users/index">
    <view class="stat-num" style="color:#4f46e5;">{{stats.userCount}}</view>
    <view class="stat-label">活跃用户</view>
  </view>
  <view class="stat-cell" bindtap="goTo" data-url="/pages/admin/stores/index">
    <view class="stat-num" style="color:#0f766e;">{{stats.storeCount}}</view>
    <view class="stat-label">店铺</view>
  </view>
  <view class="stat-cell" bindtap="goTo" data-url="/pages/admin/stores/index">
    <view class="stat-num" style="color:#ea580c;">{{stats.supplierCount}}</view>
    <view class="stat-label">供货商</view>
  </view>
  <view class="stat-cell" bindtap="goTo" data-url="/pages/admin/orders/index">
    <view class="stat-num" style="color:#8b5cf6;">{{stats.orderCount}}</view>
    <view class="stat-label">总订单</view>
  </view>
</view>

<!-- 待处理提醒 -->
<view class="card" wx:if="{{stats.pendingUsers > 0 || stats.pendingOrders > 0}}">
  <view style="font-size:30rpx;font-weight:700;margin-bottom:20rpx;">⚠️ 待处理</view>
  <view style="display:flex;gap:16rpx;">
    <view wx:if="{{stats.pendingUsers > 0}}" style="flex:1;text-align:center;background:#fef3c7;border-radius:16rpx;padding:20rpx;" bindtap="goTo" data-url="/pages/admin/users/index">
      <view style="font-size:36rpx;font-weight:800;color:#f59e0b;">{{stats.pendingUsers}}</view>
      <view style="font-size:24rpx;color:#f59e0b;">用户待审核</view>
    </view>
    <view wx:if="{{stats.pendingOrders > 0}}" style="flex:1;text-align:center;background:#eef2ff;border-radius:16rpx;padding:20rpx;" bindtap="goTo" data-url="/pages/admin/orders/index">
      <view style="font-size:36rpx;font-weight:800;color:#4f46e5;">{{stats.pendingOrders}}</view>
      <view style="font-size:24rpx;color:#4f46e5;">订单待确认</view>
    </view>
  </view>
</view>

<!-- ==================== 统计报表 ==================== -->
<view class="card" style="background:linear-gradient(135deg,#6366f1,#818cf8);color:#fff;border-radius:24rpx 24rpx 0 0;margin-bottom:0;">
  <view style="display:flex;justify-content:space-between;align-items:center;">
    <view>
      <view style="font-size:32rpx;font-weight:700;">📊 统计报表</view>
      <view style="font-size:22rpx;opacity:.8;margin-top:4rpx;">按门店与时间查看订单数据</view>
    </view>
  </view>
</view>

<!-- 筛选区 -->
<view class="card" style="border-radius:0 0 24rpx 24rpx;margin-top:0;padding-top:0;">
  <!-- 时间筛选 -->
  <view style="display:flex;gap:16rpx;margin-bottom:20rpx;">
    <view wx:for="{{[{v:'1',l:'今天'},{v:'7',l:'近7天'},{v:'30',l:'近30天'},{v:'month',l:'本月'},{v:'365',l:'近一年'}]}}" wx:key="v" style="flex:1;text-align:center;padding:16rpx 0;border-radius:16rpx;font-size:26rpx;{{reportRange === item.v ? 'background:#4f46e5;color:#fff;' : 'background:#f1f5f9;color:#64748b;'}}" bindtap="onRangeChange" data-range="{{item.v}}">
      {{item.l}}
    </view>
  </view>

  <!-- 门店筛选 -->
  <picker mode="selector" range="{{storeOptions}}" range-key="name" value="{{storePickerIndex}}" bindchange="onStoreChange">
    <view style="display:flex;justify-content:space-between;align-items:center;background:#f8fafc;border-radius:16rpx;padding:20rpx 24rpx;">
      <view style="display:flex;align-items:center;gap:12rpx;">
        <view style="font-size:28rpx;">🏪</view>
        <view style="font-size:26rpx;color:#64748b;">筛选门店</view>
      </view>
      <view style="display:flex;align-items:center;gap:8rpx;">
        <view style="font-size:28rpx;font-weight:600;color:#1e293b;">{{reportStoreName}}</view>
        <view style="font-size:24rpx;color:#94a3b8;">▼</view>
      </view>
    </view>
  </picker>
</view>

<!-- 报表统计卡片 -->
<view class="stat-row card">
  <view class="stat-cell">
    <view class="stat-num" style="color:#4f46e5;">{{reportOrders}}</view>
    <view class="stat-label">订单数</view>
  </view>
  <view class="stat-cell">
    <view class="stat-num" style="color:#ef4444;">¥{{reportAmount}}</view>
    <view class="stat-label">总金额</view>
  </view>
  <view class="stat-cell">
    <view class="stat-num" style="color:#0f766e;">¥{{reportAvg}}</view>
    <view class="stat-label">平均客单</view>
  </view>
</view>

<!-- 趋势柱状图 -->
<view class="card">
  <view style="font-size:28rpx;font-weight:700;margin-bottom:24rpx;">📈 订单金额趋势（{{reportRangeName}}）</view>
  <view wx:if="{{chartData.length > 0}}">
    <scroll-view scroll-x style="width:100%;white-space:nowrap;">
      <view style="display:flex;align-items:flex-end;gap:4rpx;height:240rpx;padding-bottom:4rpx;{{chartWidthStyle}}">
    <view wx:for="{{chartData}}" wx:key="label" style="flex:1;min-width:44rpx;display:flex;flex-direction:column;align-items:center;height:100%;justify-content:flex-end;">
      <view wx:if="{{item.amount > 0}}" style="font-size:18rpx;color:#6b7280;margin-bottom:4rpx;">¥{{item.amount}}</view>
      <view style="width:100%;max-width:40rpx;background:linear-gradient(to top,#4f46e5,#6366f1);border-radius:6rpx 6rpx 0 0;height:{{item.amount/chartMax*180}}rpx;min-height:{{item.amount > 0 ? '8rpx' : '0'}};"></view>
      <view style="font-size:18rpx;color:#94a3b8;margin-top:8rpx;white-space:nowrap;">{{item.label}}</view>
    </view>
      </view>
    </scroll-view>
  </view>
  <view wx:else style="text-align:center;color:#94a3b8;padding:40rpx 0;">暂无数据</view>
</view>

<!-- 按门店统计 -->
<view class="card" wx:if="{{storeList.length > 0}}">
  <view style="display:flex;align-items:center;margin-bottom:20rpx;">
    <view style="flex:1;font-size:28rpx;font-weight:700;">🏪 各门店订单统计</view>
    <view class="btn-sm" style="background:#4f46e5;color:#fff;" bindtap="exportStoreReport">导出Excel</view>
  </view>
  <view wx:for="{{storeList}}" wx:key="name" style="display:flex;align-items:center;padding:16rpx 0;border-bottom:1rpx solid #f1f5f9;">
    <view style="flex:1;">
      <view style="font-weight:600;">{{item.name}}</view>
      <view style="font-size:24rpx;color:#94a3b8;">{{item.count}} 笔订单</view>
    </view>
    <view style="font-weight:700;color:#ef4444;font-size:30rpx;">¥{{item.amountText}}</view>
  </view>
  <view style="margin-top:16rpx;">
    <view class="btn btn-block btn-outline" style="border-color:#4f46e5;color:#4f46e5;" bindtap="exportOrderDetail">导出订单明细Excel</view>
  </view>
</view>

<!-- 按供应商统计 -->
<view class="card" wx:if="{{supplierList.length > 0}}">
  <view style="display:flex;align-items:center;margin-bottom:20rpx;">
    <view style="flex:1;font-size:28rpx;font-weight:700;">🚚 各供应商订单统计</view>
    <view class="btn-sm" style="background:#ea580c;color:#fff;" bindtap="exportSupplierReport">导出Excel</view>
  </view>
  <view wx:for="{{supplierList}}" wx:key="name" style="display:flex;align-items:center;padding:16rpx 0;border-bottom:1rpx solid #f1f5f9;">
    <view style="flex:1;">
      <view style="font-weight:600;">{{item.name}}</view>
      <view style="font-size:24rpx;color:#94a3b8;">{{item.count}} 笔订单</view>
    </view>
    <view style="font-weight:700;color:#ef4444;font-size:30rpx;">¥{{item.amountText}}</view>
  </view>
</view>

<!-- 待审核用户 -->
<view class="card" wx:if="{{pendingUsers.length > 0}}">
  <view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16rpx;" bindtap="goTo" data-url="/pages/admin/users/index">
    <text style="font-size:30rpx;font-weight:700;">待审核用户</text>
    <text style="color:#64748b;font-size:24rpx;">全部 ›</text>
  </view>
  <view wx:for="{{pendingUsers}}" wx:key="_id" style="display:flex;align-items:center;padding:16rpx 0;border-bottom:1rpx solid #f1f5f9;">
    <view style="width:60rpx;height:60rpx;border-radius:50%;background:#fef3c7;display:flex;align-items:center;justify-content:center;font-size:28rpx;margin-right:16rpx;">👤</view>
    <view style="flex:1;">
      <view style="font-weight:600;">{{item.name}}</view>
      <view style="font-size:24rpx;color:#94a3b8;">{{item.role === 'admin' ? '管理员' : item.role === 'manager' ? '店长' : '供货商'}} · {{item.phone}}</view>
    </view>
    <view class="tag tag-pending">待审核</view>
  </view>
</view>

<!-- 最近订单 -->
<view class="card">
  <view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16rpx;" bindtap="goTo" data-url="/pages/admin/orders/index">
    <text style="font-size:30rpx;font-weight:700;">最近订单</text>
    <text style="color:#64748b;font-size:24rpx;">全部 ›</text>
  </view>
  <view wx:if="{{recentOrders.length === 0}}" class="empty-block">
    <view class="empty-ico">📋</view>
    <view>暂无订单</view>
  </view>
  <view wx:for="{{recentOrders}}" wx:key="_id" style="display:flex;align-items:center;padding:16rpx 0;border-bottom:1rpx solid #f1f5f9;">
    <view style="flex:1;">
      <view style="font-weight:600;">{{item.no}}</view>
      <view style="font-size:24rpx;color:#94a3b8;">{{item.storeName}} → {{item.supplierName}}</view>
    </view>
    <view style="text-align:right;">
      <view style="font-weight:700;color:#ef4444;">¥{{item.total}}</view>
      <view class="tag tag-{{item.status}}">{{item.status === 'pending' ? '待确认' : item.status === 'accepted' ? '已接单' : item.status === 'shipped' ? '配送中' : item.status === 'partial' ? '部分收货' : item.status === 'received' ? '已收货' : '已取消'}}</view>
    </view>
  </view>
</view>

<tabbar current="dashboard" />
