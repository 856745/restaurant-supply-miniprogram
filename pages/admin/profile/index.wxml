<view class="fix-top"></view>

<!-- 个人信息 -->
<view class="card" style="text-align:center;padding:48rpx 28rpx;">
  <view style="width:100rpx;height:100rpx;border-radius:50%;background:#eef2ff;display:flex;align-items:center;justify-content:center;font-size:48rpx;margin:0 auto 16rpx;">👑</view>
  <view style="font-size:36rpx;font-weight:700;">{{userInfo.name || '管理员'}}</view>
  <view style="font-size:26rpx;color:#94a3b8;margin-top:8rpx;">系统管理员 · {{userInfo.phone || ''}}</view>
</view>

<!-- 数据统计 -->
<view class="card">
  <view class="stat-row">
    <view class="stat-cell">
      <view class="stat-num" style="color:#4f46e5;">{{stats.userCount}}</view>
      <view class="stat-label">活跃用户</view>
    </view>
    <view class="stat-cell">
      <view class="stat-num" style="color:#0f766e;">{{stats.storeCount}}</view>
      <view class="stat-label">店铺</view>
    </view>
    <view class="stat-cell">
      <view class="stat-num" style="color:#ea580c;">{{stats.supplierCount}}</view>
      <view class="stat-label">供货商</view>
    </view>
  </view>
</view>

<!-- 功能列表 -->
<view class="card">
  <view style="font-size:30rpx;font-weight:700;margin-bottom:16rpx;">系统管理</view>
  <view style="padding:24rpx 0;border-bottom:1rpx solid #f1f5f9;display:flex;align-items:center;" bindtap="exportData">
    <text style="flex:1;">📥 导出全部数据</text>
    <text style="color:#94a3b8;">›</text>
  </view>
  <view style="padding:24rpx 0;border-bottom:1rpx solid #f1f5f9;display:flex;align-items:center;" bindtap="exportAuditLogs">
    <text style="flex:1;">📋 导出操作日志</text>
    <text style="color:#94a3b8;">›</text>
  </view>
  <view style="padding:24rpx 0;border-bottom:1rpx solid #f1f5f9;display:flex;align-items:center;" bindtap="cleanOldLogs">
    <text style="flex:1;">🧹 清理旧日志（90天前）</text>
    <text style="color:#94a3b8;">›</text>
  </view>
  <view style="padding:24rpx 0;border-bottom:1rpx solid #f1f5f9;display:flex;align-items:center;" bindtap="goMessages">
    <text style="flex:1;">💌 消息中心</text>
    <text wx:if="{{unreadMsgCount > 0}}" style="background:#ef4444;color:#fff;font-size:20rpx;padding:2rpx 14rpx;border-radius:20rpx;margin-right:8rpx;">{{unreadMsgCount}}</text>
    <text style="color:#94a3b8;">›</text>
  </view>
  <view style="padding:24rpx 0;border-bottom:1rpx solid #f1f5f9;display:flex;align-items:center;" bindtap="goFeedbackList">
    <text style="flex:1;">📥 反馈管理</text>
    <text style="color:#94a3b8;">›</text>
  </view>
  <view style="padding:24rpx 0;border-bottom:1rpx solid #f1f5f9;display:flex;align-items:center;" bindtap="goFeedback">
    <text style="flex:1;">💬 意见反馈</text>
    <text style="color:#94a3b8;">›</text>
  </view>
  <view style="padding:24rpx 0;border-bottom:1rpx solid #f1f5f9;display:flex;align-items:center;" bindtap="showPrivacy">
    <text style="flex:1;">📜 隐私政策</text>
    <text style="color:#94a3b8;">›</text>
  </view>
  <view style="padding:24rpx 0;display:flex;align-items:center;" bindtap="logout">
    <text style="flex:1;color:#ef4444;">🚪 退出登录</text>
    <text style="color:#94a3b8;">›</text>
  </view>
</view>

<view class="card">
  <view style="font-size:24rpx;color:#94a3b8;text-align:center;">
    餐饮供货管理平台 v1.0
  </view>
</view>

<privacy-popup show="{{showPrivacyModal}}" bind:close="onClosePrivacy" />

<tabbar current="profile" />
