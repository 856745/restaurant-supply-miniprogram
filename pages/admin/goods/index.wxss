/* 货品缩略图 */
.goods-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 12rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

/* 弹窗内 textarea 样式复用 */
.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 供货商联想下拉 */
.supplier-suggest {
  position: relative;
  z-index: 10;
  margin-top: 8rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,.08);
  max-height: 400rpx;
  overflow-y: auto;
}

.supplier-suggest-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.supplier-suggest-item:last-child {
  border-bottom: none;
}

.supplier-suggest-item:active {
  background: #f8fafc;
}

.supplier-suggest-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.supplier-suggest-contact {
  font-size: 24rpx;
  color: #94a3b8;
}
