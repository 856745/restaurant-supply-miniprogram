/* admin orders detail */

/* 收货弹窗步进器 */
.step-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
}
.step-btn.add {
  background: #0f766e;
  color: #fff;
}
.step-btn.sub {
  background: #fff;
  color: #0f766e;
  border: 2rpx solid #0f766e;
}
.step-btn.disabled {
  opacity: 0.4;
}
.recv-input {
  width: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border: 1rpx solid #e2e8f0;
  border-radius: 8rpx;
  padding: 8rpx 0;
}
