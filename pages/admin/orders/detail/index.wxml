<view class="fix-top"></view>

<!-- 订单基本信息 -->
<view class="card" style="background:linear-gradient(135deg,#8b5cf6,#a78bfa);color:#fff;border-radius:24rpx;">
  <view style="display:flex;justify-content:space-between;align-items:center;">
    <view style="font-size:32rpx;font-weight:700;">{{order.no}}</view>
    <view class="tag tag-{{order.status}}" style="background:rgba(255,255,255,.2);color:#fff;border:1rpx solid rgba(255,255,255,.3);">
      {{statusLabels[order.status] || order.status}}
    </view>
  </view>
  <view style="display:flex;gap:32rpx;margin-top:20rpx;font-size:24rpx;opacity:.9;">
    <view>{{order.storeName}} → {{order.supplierName}}</view>
  </view>
  <view style="font-size:24rpx;opacity:.7;margin-top:8rpx;">创建时间：{{order.createTime}}</view>
</view>

<!-- 货品清单 -->
<view class="card">
  <view style="font-size:30rpx;font-weight:700;margin-bottom:20rpx;">货品清单</view>
  <view wx:for="{{order.items}}" wx:key="goodsId" style="display:flex;align-items:center;padding:16rpx 0;border-bottom:1rpx solid #f1f5f9;">
    <view style="flex:1;">
      <view style="font-weight:600;">{{item.name}}</view>
      <view style="font-size:24rpx;color:#94a3b8;">{{item.qty}} {{item.unit}} × ¥{{item.price}}</view>
    </view>
    <view style="font-weight:700;color:#ef4444;font-size:30rpx;">¥{{item.amount}}</view>
  </view>
  <view style="display:flex;justify-content:space-between;align-items:center;padding-top:20rpx;margin-top:8rpx;">
    <view style="font-size:28rpx;color:#64748b;">共 {{order.items.length}} 种货品</view>
    <view style="font-size:36rpx;font-weight:800;color:#ef4444;">¥{{order.total}}</view>
  </view>
</view>

<!-- 状态流转 -->
<view class="card">
  <view style="font-size:30rpx;font-weight:700;margin-bottom:24rpx;">状态流转</view>
  <view wx:for="{{statusSteps}}" wx:key="label" style="display:flex;align-items:flex-start;margin-bottom:8rpx;">
    <view style="width:48rpx;display:flex;flex-direction:column;align-items:center;flex-shrink:0;">
      <view style="width:20rpx;height:20rpx;border-radius:50%;background:{{item.done ? '#8b5cf6' : '#e2e8f0'}};margin-top:6rpx;"></view>
      <view wx:if="{{index < statusSteps.length - 1}}" style="width:2rpx;flex:1;min-height:30rpx;background:{{statusSteps[index + 1].done ? '#8b5cf6' : '#e2e8f0'}};margin:2rpx 0;"></view>
    </view>
    <view style="flex:1;padding-left:16rpx;padding-bottom:8rpx;">
      <view style="font-weight:600;color:{{item.done ? '#1e293b' : '#94a3b8'}};">{{item.label}}</view>
      <view wx:if="{{item.time}}" style="font-size:22rpx;color:#94a3b8;margin-top:2rpx;">{{item.time}}</view>
    </view>
  </view>
</view>

<!-- 备注 -->
<view class="card" wx:if="{{order.remark}}">
  <view style="font-size:28rpx;font-weight:600;color:#64748b;margin-bottom:8rpx;">备注</view>
  <view style="font-size:28rpx;color:#1e293b;line-height:1.6;">{{order.remark}}</view>
</view>

<!-- 操作按钮 -->
<view class="card" wx:if="{{order.status === 'shipped' || order.status === 'partial' || order.status === 'pending' || order.status === 'accepted'}}">
  <view style="font-size:30rpx;font-weight:700;margin-bottom:24rpx;">订单操作</view>
  <view style="display:flex;gap:24rpx;">
    <view wx:if="{{order.status === 'pending' || order.status === 'accepted'}}"
      bindtap="cancelOrder"
      style="flex:1;text-align:center;padding:24rpx;border-radius:16rpx;border:2rpx solid #ef4444;color:#ef4444;font-size:28rpx;font-weight:600;">
      取消订单
    </view>
    <view wx:if="{{order.status === 'shipped' || order.status === 'partial'}}"
      bindtap="openReceivePopup"
      style="flex:1;text-align:center;padding:24rpx;border-radius:16rpx;background:#0f766e;color:#fff;font-size:28rpx;font-weight:600;">
      确认收货
    </view>
  </view>
</view>

<!-- 部分收货弹窗 -->
<view class="modal-mask" wx:if="{{showReceive}}">
  <view class="modal-overlay" catchtap="closeReceive"></view>
  <view class="modal-body" style="max-height:75vh;">
    <view class="modal-title">确认收货</view>
    <view wx:for="{{receiveItems}}" wx:key="goodsId" style="display:flex;align-items:center;padding:16rpx 0;border-bottom:1rpx solid #f1f5f9;">
      <view style="flex:1;">
        <view style="font-weight:600;">{{item.name}}</view>
        <view style="font-size:22rpx;color:#94a3b8;">订购 {{item.qty}} {{item.unit}} × ¥{{item.price}}</view>
      </view>
      <view style="display:flex;align-items:center;gap:16rpx;">
        <view class="step-btn {{item.receivedQty <= 0 ? 'disabled' : ''}}" bindtap="onRecvSub" data-idx="{{index}}">-</view>
        <input class="recv-input" type="digit" value="{{item._displayVal}}" bindinput="onRecvInput" data-idx="{{index}}" />
        <view class="step-btn {{item.receivedQty >= item.qty ? 'disabled' : ''}}" bindtap="onRecvAdd" data-idx="{{index}}">+</view>
      </view>
      <view style="width:120rpx;text-align:right;font-weight:600;color:#0f766e;">¥{{item.receivedAmount}}</view>
    </view>
    <view style="display:flex;gap:16rpx;margin-top:24rpx;">
      <view class="btn btn-outline" bindtap="closeReceive" style="flex:1;text-align:center;padding:20rpx;border-radius:12rpx;">取消</view>
      <view class="btn" bindtap="confirmReceive" style="flex:1;background:#0f766e;color:#fff;text-align:center;padding:20rpx;border-radius:12rpx;font-weight:600;">确认收货</view>
    </view>
  </view>
</view>

<!-- 底部返回 -->
<view style="padding:32rpx;text-align:center;">
  <view class="btn btn-outline" bindtap="goBack" style="background:#f1f5f9;color:#64748b;">返回订单列表</view>
</view>
