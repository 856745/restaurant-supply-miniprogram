.login-page { min-height:100vh; display:flex; flex-direction:column; background:linear-gradient(180deg, #f8fafc 0%, #eef2ff 60%, #f1f5f9 100%); padding-bottom:60rpx; box-sizing:border-box; }
.login-header { text-align:center; padding:120rpx 0 60rpx; transition:padding .2s; }
.login-logo { font-size:60rpx; font-weight:800; color:#0f172a; letter-spacing:8rpx; }
.login-subtitle { font-size:28rpx; color:#64748b; margin-top:16rpx; }
.login-body { flex:1; padding:0 48rpx; }
.login-title { font-size:36rpx; font-weight:700; margin-bottom:32rpx; display:flex; align-items:center; gap:16rpx; }
.role-badge { font-size:24rpx; font-weight:500; background:#e2e8f0; color:#475569; padding:4rpx 16rpx; border-radius:8rpx; }

.role-list { display:flex; flex-direction:column; gap:24rpx; }
.role-card { border:2rpx solid; border-radius:20rpx; padding:32rpx 28rpx; position:relative; transition:transform .15s; }
.role-card:active { transform:scale(.98); }
.role-name { font-size:34rpx; font-weight:700; margin-bottom:8rpx; }
.role-desc { font-size:26rpx; color:#64748b; }
.role-arrow { position:absolute; right:28rpx; top:50%; transform:translateY(-50%); font-size:32rpx; font-weight:600; }

.link-btn { text-align:center; margin-top:28rpx; color:#64748b; font-size:26rpx; }
.login-footer { text-align:center; padding:40rpx 0; font-size:24rpx; color:#94a3b8; }

/* 表单模式：缩小头部，让表单内容完整显示 */
.form-mode .login-header { padding:60rpx 0 30rpx; }
.form-mode .login-body { padding:0 48rpx; }
.form-mode .login-title { margin-bottom:24rpx; }
