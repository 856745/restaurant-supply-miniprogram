<view class="manager-theme fix-top reports-page">

  <!-- 标题 -->
  <view class="card" style="background:linear-gradient(135deg,#0f766e,#14b8a6);color:#fff;border-radius:24rpx;">
    <view style="font-size:34rpx;font-weight:700;">📊 采购报表</view>
    <view style="font-size:24rpx;opacity:.85;margin-top:8rpx;">按时间、供应商、商品分析采购数据</view>
  </view>

  <!-- 筛选区 -->
  <view class="card">
    <!-- 搜索栏 -->
    <view class="search-bar" style="margin-bottom:20rpx;">
      <text class="search-ico">🔍</text>
      <input placeholder="搜索商品名称或订单号" value="{{keyword}}" bindinput="onSearch" confirm-type="search" />
    </view>

    <!-- 时间筛选 -->
    <view style="display:flex;gap:16rpx;margin-bottom:20rpx;">
      <view wx:for="{{[{v:'7',l:'近7天'},{v:'month',l:'本月'},{v:'365',l:'近一年'}]}}" wx:key="v" style="flex:1;text-align:center;padding:16rpx 0;border-radius:16rpx;font-size:26rpx;{{reportRange === item.v ? 'background:#0f766e;color:#fff;' : 'background:#f1f5f9;color:#64748b;'}}" bindtap="onRangeChange" data-range="{{item.v}}">
        {{item.l}}
      </view>
    </view>

    <!-- 供应商筛选 -->
    <picker mode="selector" range="{{supplierOptions}}" range-key="name" value="{{supplierPickerIndex}}" bindchange="onSupplierChange">
      <view class="filter-row">
        <view style="display:flex;align-items:center;">
          <view style="font-size:28rpx;">🏪</view>
          <view style="font-size:26rpx;color:#64748b;margin-left:12rpx;">筛选供应商</view>
        </view>
        <view style="display:flex;align-items:center;">
          <view style="font-size:28rpx;font-weight:600;color:#1e293b;">{{reportSupplierName}}</view>
          <view style="font-size:24rpx;color:#94a3b8;margin-left:8rpx;">▼</view>
        </view>
      </view>
    </picker>

    <!-- 分类筛选 -->
    <picker mode="selector" range="{{categoryOptions}}" range-key="name" value="{{categoryPickerIndex}}" bindchange="onCategoryChange">
      <view class="filter-row" style="margin-top:12rpx;">
        <view style="display:flex;align-items:center;">
          <view style="font-size:28rpx;">🏷️</view>
          <view style="font-size:26rpx;color:#64748b;margin-left:12rpx;">筛选分类</view>
        </view>
        <view style="display:flex;align-items:center;">
          <view style="font-size:28rpx;font-weight:600;color:#1e293b;">{{reportCategoryName}}</view>
          <view style="font-size:24rpx;color:#94a3b8;margin-left:8rpx;">▼</view>
        </view>
      </view>
    </picker>

    <!-- 商品筛选 -->
    <picker mode="selector" range="{{goodsOptions}}" range-key="name" value="{{goodsPickerIndex}}" bindchange="onGoodsChange">
      <view class="filter-row" style="margin-top:12rpx;">
        <view style="display:flex;align-items:center;">
          <view style="font-size:28rpx;">📦</view>
          <view style="font-size:26rpx;color:#64748b;margin-left:12rpx;">筛选商品</view>
        </view>
        <view style="display:flex;align-items:center;">
          <view style="font-size:28rpx;font-weight:600;color:#1e293b;">{{reportGoodsName}}</view>
          <view style="font-size:24rpx;color:#94a3b8;margin-left:8rpx;">▼</view>
        </view>
      </view>
    </picker>
  </view>

  <!-- 汇总卡片 -->
  <view class="card">
    <view style="font-size:28rpx;font-weight:700;margin-bottom:16rpx;">采购总览（{{reportRangeName}}）</view>
    <view class="stat-row">
      <view class="stat-cell">
        <view class="stat-num" style="color:var(--text);">{{totalOrders}}</view>
        <view class="stat-label">总订单</view>
      </view>
      <view class="stat-cell">
        <view class="stat-num" style="color:#e53e3e;">¥{{totalSpent}}</view>
        <view class="stat-label">总采购额</view>
      </view>
      <view class="stat-cell">
        <view class="stat-num" style="color:#0f766e;">¥{{avgOrder}}</view>
        <view class="stat-label">客单价</view>
      </view>
    </view>
  </view>

  <!-- 商品采购统计 -->
  <view class="card" wx:if="{{goodsStats.length}}">
    <view style="display:flex;align-items:center;margin-bottom:16rpx;">
      <view style="flex:1;font-size:28rpx;font-weight:700;">📦 商品采购统计</view>
      <view class="btn-sm" style="background:#0f766e;color:#fff;" bindtap="exportGoodsReport">导出Excel</view>
    </view>

    <view wx:for="{{goodsStats}}" wx:key="goodsId" style="border-bottom:1rpx solid #f5f5f5;padding:16rpx 0;">
      <!-- 商品汇总行 -->
      <view style="display:flex;align-items:center;" bindtap="toggleGoodsDetail" data-id="{{item.goodsId}}">
        <view style="flex:1;overflow:hidden;">
          <view style="font-size:28rpx;font-weight:600;">{{item.name}}</view>
          <view style="font-size:22rpx;color:#999;margin-top:4rpx;">
            <text>{{item.orderCount}}次</text>
            <text wx:if="{{item.qtySummary}}" style="margin-left:12rpx;color:#0f766e;">{{item.qtySummary}}{{item.unit}}</text>
            <text style="margin-left:12rpx;">共{{item.totalQty}}{{item.unit}}</text>
          </view>
        </view>
        <view style="text-align:right;flex-shrink:0;">
          <view style="font-size:30rpx;font-weight:700;color:#e53e3e;">¥{{item.totalAmount}}</view>
          <view style="font-size:20rpx;color:#94a3b8;">{{expandedGoodsId === item.goodsId ? '收起 ▲' : '明细 ▼'}}</view>
        </view>
      </view>

      <!-- 展开明细 -->
      <view wx:if="{{expandedGoodsId === item.goodsId}}" style="margin-top:12rpx;background:#f8fafc;border-radius:12rpx;padding:12rpx 16rpx;">
        <view wx:for="{{item.orders}}" wx:for-item="ord" wx:key="*this"
          style="display:flex;align-items:center;padding:8rpx 0;border-bottom:1rpx solid #f1f5f9;font-size:24rpx;">
          <view style="flex:1;color:#64748b;">{{ord.date}} {{ord.no}}</view>
          <view style="color:#64748b;margin-right:16rpx;">{{ord.supplierName}}</view>
          <view style="color:#0f766e;font-weight:600;margin-right:16rpx;">{{ord.qty}}{{item.unit}}</view>
          <view style="color:#e53e3e;font-weight:600;width:120rpx;text-align:right;">¥{{ord.amount}}</view>
        </view>
        <view style="display:flex;padding:8rpx 0;font-size:24rpx;font-weight:700;">
          <view style="flex:1;color:#1e293b;">小计</view>
          <view style="color:#0f766e;margin-right:16rpx;">{{item.totalQty}}{{item.unit}}</view>
          <view style="color:#e53e3e;width:120rpx;text-align:right;">¥{{item.totalAmount}}</view>
        </view>
      </view>
    </view>

    <!-- 导出明细按钮 -->
    <view style="margin-top:16rpx;">
      <view class="btn btn-block btn-outline" style="border-color:#0f766e;color:#0f766e;" bindtap="exportFullReport">导出采购明细Excel</view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="card" wx:if="{{!goodsStats.length}}" style="text-align:center;padding:40rpx 0;color:#94a3b8;">
    <view style="font-size:48rpx;">📭</view>
    <view style="font-size:26rpx;margin-top:8rpx;">当前筛选条件下暂无采购数据</view>
  </view>

  <!-- 订单状态分布 -->
  <view class="card">
    <view style="font-size:28rpx;font-weight:700;margin-bottom:16rpx;">订单状态分布</view>
    <view wx:for="{{statusStats}}" wx:key="id"
      style="display:flex;align-items:center;padding:12rpx 0;border-bottom:1rpx solid #f5f5f5;">
      <view style="width:16rpx;height:16rpx;border-radius:50%;background:{{item.color}};margin-right:16rpx;"></view>
      <text style="flex:1;font-size:28rpx;">{{item.name}}</text>
      <text style="font-size:28rpx;font-weight:700;color:{{item.color}};">{{item.count}}</text>
    </view>
  </view>

  <!-- 趋势柱状图 -->
  <view class="card">
    <view style="font-size:28rpx;font-weight:700;margin-bottom:24rpx;">📈 采购金额趋势（{{reportRangeName}}）</view>
    <view wx:if="{{chartData.length > 0}}">
      <scroll-view scroll-x style="width:100%;white-space:nowrap;">
        <view style="display:flex;align-items:flex-end;gap:4rpx;height:240rpx;padding-bottom:4rpx;{{chartWidthStyle}}">
          <view wx:for="{{chartData}}" wx:key="label" style="flex:1;min-width:44rpx;display:flex;flex-direction:column;align-items:center;height:100%;justify-content:flex-end;">
            <view wx:if="{{item.amount > 0}}" style="font-size:18rpx;color:#6b7280;margin-bottom:4rpx;">¥{{item.amount}}</view>
            <view style="width:100%;max-width:40rpx;background:linear-gradient(to top,#0f766e,#14b8a6);border-radius:6rpx 6rpx 0 0;height:{{item.amount/chartMax*180}}rpx;min-height:{{item.amount > 0 ? '8rpx' : '0'}};"></view>
            <view style="font-size:18rpx;color:#94a3b8;margin-top:8rpx;white-space:nowrap;">{{item.label}}</view>
          </view>
        </view>
      </scroll-view>
    </view>
    <view wx:else style="text-align:center;color:#94a3b8;padding:40rpx 0;">暂无数据</view>
  </view>

  <!-- 按供应商统计 -->
  <view class="card" wx:if="{{supplierStats.length}}">
    <view style="font-size:28rpx;font-weight:700;margin-bottom:16rpx;">供应商采购排行</view>
    <view wx:for="{{supplierStats}}" wx:key="name"
      style="display:flex;align-items:center;padding:16rpx 0;border-bottom:1rpx solid #f5f5f5;">
      <view style="width:48rpx;height:48rpx;border-radius:50%;background:#f0fdfa;display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:700;color:#0f766e;margin-right:16rpx;">{{index + 1}}</view>
      <view style="flex:1;">
        <view style="font-size:28rpx;font-weight:600;">{{item.name}}</view>
        <view style="font-size:22rpx;color:#999;">{{item.count}}单</view>
      </view>
      <view style="font-size:30rpx;font-weight:700;color:#e53e3e;">¥{{item.totalText}}</view>
    </view>
  </view>

  <!-- 按分类统计 -->
  <view class="card" wx:if="{{categoryStats.length}}">
    <view style="font-size:28rpx;font-weight:700;margin-bottom:16rpx;">分类采购统计</view>
    <view wx:for="{{categoryStats}}" wx:key="catId"
      style="display:flex;align-items:center;padding:16rpx 0;border-bottom:1rpx solid #f5f5f5;">
      <text style="font-size:36rpx;margin-right:16rpx;">{{item.catIcon}}</text>
      <view style="flex:1;">
        <view style="font-size:28rpx;font-weight:600;">{{item.catName}}</view>
        <view style="font-size:22rpx;color:#999;">采购量 {{item.count}}</view>
      </view>
      <view style="font-size:28rpx;font-weight:700;color:#0f766e;">¥{{item.totalText}}</view>
    </view>
  </view>

  <view style="height:40rpx;"></view>
</view>
