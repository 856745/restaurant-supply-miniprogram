/* ========== 店长订单页 ========== */
.orders-page {
  background: #f5f5f5;
  min-height: 100vh;
}

/* 状态筛选 Tab */
.status-tabs {
  background: #fff;
  padding: 16rpx 0;
  position: sticky;
  top: 0;
  z-index: 90;
  border-bottom: 1rpx solid #f0f0f0;
}
.status-scroll {
  white-space: nowrap;
  padding: 0 24rpx;
}
.status-tab {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-right: 12rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  background: #f5f5f5;
  color: #666;
  transition: all .2s;
}
.status-tab.active {
  background: #0f766e;
  color: #fff;
  font-weight: 600;
}

/* 订单卡片 */
.orders-list {
  padding: 16rpx 24rpx;
}
.order-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.order-card-header {
  display: flex;
  align-items: center;
}
.order-no {
  flex: 1;
  font-size: 28rpx;
  font-weight: 700;
  color: #222;
}
.order-card-sub {
  display: flex;
  align-items: center;
  margin-top: 8rpx;
}
.order-supplier {
  flex: 1;
  font-size: 24rpx;
  color: #0f766e;
  font-weight: 600;
}
.order-time {
  font-size: 22rpx;
  color: #bbb;
}
.order-card-summary {
  display: flex;
  align-items: flex-end;
  margin-top: 12rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #f5f5f5;
}
.order-items-text {
  flex: 1;
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 16rpx;
}
.order-total {
  font-size: 32rpx;
  font-weight: 700;
  color: #e53e3e;
  white-space: nowrap;
}

/* 展开详情 */
.order-detail {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}
.order-detail-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #64748b;
  margin-bottom: 8rpx;
}
.order-detail-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  font-size: 26rpx;
  gap: 12rpx;
}
.detail-name {
  flex: 1;
  font-weight: 600;
  color: #333;
}
.detail-spec {
  font-size: 22rpx;
  color: #999;
  min-width: 60rpx;
}
.detail-qty {
  font-size: 24rpx;
  color: #666;
  min-width: 60rpx;
  text-align: right;
}
.detail-price {
  font-size: 24rpx;
  color: #999;
  min-width: 80rpx;
  text-align: right;
}
.detail-amount {
  font-size: 26rpx;
  font-weight: 600;
  color: #e53e3e;
  min-width: 80rpx;
  text-align: right;
}

/* 同批次标记 */
.batch-badge {
  display: inline-block;
  font-size: 22rpx;
  color: #0f766e;
  background: #f0fdfa;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
  border: 1rpx solid #ccfbf1;
}

/* 操作按钮 */
.order-card-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  justify-content: flex-end;
  align-items: center;
}
.btn-ghost {
  background: transparent;
  color: #0f766e;
  border: 1rpx solid #0f766e;
}

/* 超时提醒横幅 */
.stale-banner {
  background: linear-gradient(135deg, #fef3c7, #fef9c3);
  padding: 20rpx 24rpx;
  margin: 16rpx 24rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #92400e;
  text-align: center;
  border: 1rpx solid #fde68a;
}

/* 超时小标记 */
.stale-badge {
  display: inline-block;
  font-size: 20rpx;
  color: #fff;
  background: #ef4444;
  padding: 2rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
  font-weight: 600;
  vertical-align: middle;
}

/* 超时订单标签加强 */
.tag-stale {
  border: 1rpx solid #fbbf24;
}
