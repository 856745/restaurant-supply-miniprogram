/* 店长工作台 */

/* 可点击统计格的箭头 */
.stat-arrow {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #cbd5e1;
  font-weight: 700;
}

/* 4格统计行自动缩小 */
.stat-row .stat-cell {
  padding: 16rpx 4rpx;
}
.stat-row .stat-num {
  font-size: 40rpx;
}
.stat-row .stat-label {
  font-size: 22rpx;
}

/* 消息订阅按钮 */
.notify-btn {
  padding: 12rpx 24rpx;
  background: #f59e0b;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 12rpx;
  white-space: nowrap;
}
