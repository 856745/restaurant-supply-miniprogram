<view class="manager-theme fix-top">
  <!-- 顶部店铺卡片 -->
  <view style="background:linear-gradient(135deg,#0f766e,#14b8a6);border-radius:0 0 32rpx 32rpx;padding:40rpx 32rpx;margin-bottom:24rpx;">
    <view style="color:#fff;font-size:36rpx;font-weight:700;">{{storeName}}</view>
    <view style="color:rgba(255,255,255,.7);font-size:26rpx;margin-top:8rpx;">店长工作台</view>
  </view>

  <!-- 统计行 -->
  <view class="card">
    <view class="stat-row">
      <view class="stat-cell" bindtap="goPurchase" style="position:relative;">
        <view class="stat-num" style="color:var(--text);">{{goodsCount}}</view>
        <view class="stat-label">可选货品</view>
        <view class="stat-arrow">›</view>
      </view>
      <view class="stat-cell" bindtap="goOrders" style="position:relative;">
        <view class="stat-num" style="color:#0f766e;">{{totalOrders}}</view>
        <view class="stat-label">订单数</view>
        <view class="stat-arrow">›</view>
      </view>
      <view class="stat-cell">
        <view class="stat-num" style="color:#d97706;">{{pendingOrders}}</view>
        <view class="stat-label">待收货</view>
      </view>
      <view class="stat-cell">
        <view class="stat-num" style="color:#e53e3e;">¥{{totalSpent}}</view>
        <view class="stat-label">总采购额</view>
      </view>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view style="display:flex;gap:16rpx;margin:0 24rpx 20rpx;">
    <view class="btn btn-block" style="background:#0f766e;color:#fff;flex:1;" bindtap="goPurchase">前往采购</view>
    <view class="btn btn-block" style="background:#fff;color:#0f766e;border:2rpx solid #0f766e;flex:1;" bindtap="goOrders">我的订单</view>
  </view>

  <!-- 消息订阅（供应商接单 + 配送提醒） -->
  <view style="margin:0 24rpx 20rpx;padding:20rpx 24rpx;background:#fef3c7;border:1rpx solid #fcd34d;border-radius:16rpx;display:flex;align-items:center;">
    <view style="font-size:36rpx;margin-right:16rpx;">🔔</view>
    <view style="flex:1;">
      <view style="font-size:26rpx;font-weight:600;color:#92400e;">开启订单通知</view>
      <view style="font-size:22rpx;color:#a16207;">供应商接单和配送时微信提醒你</view>
    </view>
    <view class="notify-btn" bindtap="subscribeNotify">开启</view>
  </view>

  <!-- 货品分类总览（可点击跳转采购页筛选） -->
  <view class="card" wx:if="{{goodsOverview.length}}">
    <view style="font-size:30rpx;font-weight:700;margin-bottom:16rpx;">货品分类</view>
    <view style="display:flex;flex-wrap:wrap;gap:12rpx;">
      <view wx:for="{{goodsOverview}}" wx:key="catId"
        style="background:#f0fdfa;border:1rpx solid #ccfbf1;border-radius:12rpx;padding:12rpx 20rpx;display:flex;align-items:center;gap:8rpx;"
        bindtap="goCategory" data-id="{{item.catId}}">
        <text>{{item.icon}}</text>
        <text style="font-size:26rpx;font-weight:600;color:#0f766e;">{{item.name}}</text>
        <text style="font-size:24rpx;color:#5eead4;">{{item.count}}种</text>
      </view>
    </view>
  </view>

  <!-- 最近订单（可点击跳转订单页） -->
  <view class="card" wx:if="{{recentOrders.length}}">
    <view style="display:flex;align-items:center;margin-bottom:16rpx;">
      <view style="flex:1;font-size:30rpx;font-weight:700;">最近订单</view>
      <view style="font-size:24rpx;color:#0f766e;" bindtap="goOrders">查看全部 ›</view>
    </view>
    <view wx:for="{{recentOrders}}" wx:key="_id"
      style="display:flex;align-items:center;padding:16rpx 0;border-bottom:1rpx solid var(--border);"
      bindtap="goOrderDetail" data-id="{{item._id}}">
      <view style="flex:1;">
        <view style="font-weight:600;font-size:26rpx;">{{item.no}}</view>
        <view style="font-size:24rpx;color:var(--text-2);">{{item.supplierName}}</view>
      </view>
      <view style="margin-right:16rpx;font-weight:700;">¥{{item.total}}</view>
      <view class="tag {{item.tagClass}}">{{item.statusName}}</view>
    </view>
  </view>

  <!-- 月末盘点入口 -->
  <view class="card" bindtap="goInventoryCheck" style="display:flex;align-items:center;">
    <view style="font-size:40rpx;margin-right:16rpx;">📋</view>
    <view style="flex:1;">
      <view style="font-size:28rpx;font-weight:600;">月末盘点</view>
      <view style="font-size:24rpx;color:var(--text-2);">{{inventoryTip}}</view>
    </view>
    <view style="color:#94a3b8;">›</view>
  </view>

  <!-- 报表入口 -->
  <view class="card" bindtap="goReports" style="display:flex;align-items:center;">
    <view style="font-size:40rpx;margin-right:16rpx;">📊</view>
    <view style="flex:1;">
      <view style="font-size:28rpx;font-weight:600;">采购报表</view>
      <view style="font-size:24rpx;color:var(--text-2);">查看采购统计与趋势分析</view>
    </view>
    <view style="color:#94a3b8;">›</view>
  </view>

  <!-- 空状态 -->
  <view class="empty-block" wx:if="{{!goodsOverview.length && !recentOrders.length}}">
    <view class="empty-ico">📋</view>
    <view>暂无数据</view>
  </view>

  <tabbar current="dashboard"></tabbar>
</view>
