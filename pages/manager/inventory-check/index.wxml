<view class="manager-theme fix-top">

  <!-- ========== 模式：总览 ========== -->
  <block wx:if="{{mode === 'overview'}}">
    <!-- 当月盘点状态 -->
    <view class="card" style="text-align:center;padding:40rpx 28rpx;">
      <view style="font-size:48rpx;margin-bottom:8rpx;">📋</view>
      <view style="font-size:34rpx;font-weight:700;color:#0f766e;">{{currentMonthLabel}}盘点</view>
      <view style="font-size:24rpx;color:var(--text-2);margin-top:8rpx;">{{storeName}}</view>

      <block wx:if="{{currentInv}}">
        <view style="margin-top:24rpx;padding:20rpx;background:#f0fdfa;border-radius:12rpx;">
          <view style="font-size:26rpx;color:#0f766e;font-weight:600;">✓ 本月已盘点</view>
          <view style="font-size:24rpx;color:var(--text-2);margin-top:6rpx;">
            盘点商品 {{currentInv.totalItems}} 项，有库存 {{currentInv.filledCount}} 项
          </view>
          <view style="font-size:28rpx;color:#e53e3e;font-weight:700;margin-top:8rpx;">
            库存总价值：¥{{currentInvTotal}}
          </view>
        </view>
        <view style="display:flex;gap:16rpx;margin-top:20rpx;">
          <view class="btn btn-outline" style="flex:1;border-color:#0f766e;color:#0f766e;" bindtap="exportCurrentMonth">导出Excel</view>
          <view class="btn" style="flex:1;background:#0f766e;color:#fff;" bindtap="startCheck">重新盘点</view>
        </view>
      </block>
      <block wx:else>
        <view style="margin-top:24rpx;padding:20rpx;background:#fef3c7;border-radius:12rpx;">
          <view style="font-size:26rpx;color:#d97706;font-weight:600;">⚠ 本月尚未盘点</view>
          <view style="font-size:24rpx;color:var(--text-2);margin-top:6rpx;">月末请及时完成库存盘点</view>
        </view>
        <view class="btn btn-block" style="background:#0f766e;color:#fff;margin-top:24rpx;" bindtap="startCheck">开始盘点</view>
      </block>
    </view>

    <!-- 盘点记录列表 -->
    <view class="card" wx:if="{{historyList.length}}">
      <view style="display:flex;align-items:center;margin-bottom:16rpx;">
        <view style="flex:1;font-size:30rpx;font-weight:700;">盘点记录</view>
        <view class="btn-sm" style="background:#0f766e;color:#fff;" bindtap="exportAllRecords">导出全部</view>
      </view>
      <view wx:for="{{historyList}}" wx:key="_id"
        style="padding:20rpx 0;border-bottom:1rpx solid var(--border);">
        <view style="display:flex;align-items:center;" bindtap="viewDetail" data-id="{{item._id}}">
          <view style="font-size:36rpx;margin-right:16rpx;">📊</view>
          <view style="flex:1;">
            <view style="font-weight:600;font-size:28rpx;">{{item.monthLabel}}盘点</view>
            <view style="font-size:24rpx;color:var(--text-2);">有库存 {{item.itemCount}}/{{item.totalItems}} 项 · 总价值 ¥{{item.totalValue}}</view>
          </view>
          <view style="color:#94a3b8;font-size:24rpx;">查看 ›</view>
        </view>
        <view style="display:flex;gap:12rpx;margin-top:12rpx;padding-left:52rpx;">
          <view class="btn-sm" style="border:1rpx solid #0f766e;color:#0f766e;background:#fff;" bindtap="exportRecordById" data-id="{{item._id}}">导出Excel</view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-block" wx:if="{{!currentInv && !historyList.length}}">
      <view class="empty-ico">📋</view>
      <view>暂无盘点记录</view>
    </view>
  </block>

  <!-- ========== 模式：盘点中 ========== -->
  <block wx:if="{{mode === 'checking'}}">
    <!-- 顶部信息 -->
    <view style="background:#0f766e;color:#fff;padding:24rpx 32rpx;margin-bottom:16rpx;">
      <view style="display:flex;justify-content:space-between;align-items:center;">
        <view>
          <view style="font-size:30rpx;font-weight:700;">{{currentMonthLabel}}盘点</view>
          <view style="font-size:24rpx;opacity:.8;margin-top:4rpx;">录入库存数量，自动计算总价</view>
        </view>
        <view style="text-align:right;">
          <view style="font-size:22rpx;opacity:.8;">已录 {{checkFilledCount}} 项</view>
          <view style="font-size:32rpx;font-weight:700;">¥{{checkTotalValue}}</view>
        </view>
      </view>
    </view>

    <!-- 搜索栏 -->
    <view class="search-bar">
      <text class="search-ico">🔍</text>
      <input placeholder="搜索商品名称或编号" value="{{keyword}}" bindinput="onSearch" />
    </view>

    <!-- 货品列表（按分类分组） -->
    <view wx:for="{{filteredGroups}}" wx:for-item="group" wx:for-index="gIdx" wx:key="catId" class="card">
      <!-- 分类标题 -->
      <view style="display:flex;align-items:center;margin-bottom:12rpx;">
        <text style="font-size:32rpx;margin-right:8rpx;">{{group.icon}}</text>
        <text style="font-size:28rpx;font-weight:700;color:#0f766e;">{{group.catName}}</text>
        <text style="font-size:24rpx;color:var(--text-3);margin-left:auto;">{{group.items.length}}项</text>
      </view>

      <!-- 货品行 -->
      <view wx:for="{{group.items}}" wx:for-item="item" wx:for-index="iIdx" wx:key="goodsId"
        style="padding:16rpx 0;border-bottom:1rpx solid var(--border);">
        <!-- 第一行：名称 + 数量输入 -->
        <view style="display:flex;align-items:center;">
          <view style="flex:1;overflow:hidden;">
            <view style="font-weight:600;font-size:28rpx;">{{item.name}}</view>
            <view style="font-size:22rpx;color:var(--text-3);">{{item.code}} · {{item.specWeight || '-'}} · ¥{{item.price}}/{{item.unit}}</view>
          </view>
          <view style="display:flex;align-items:center;gap:8rpx;flex-shrink:0;">
            <input type="digit" style="width:120rpx;height:64rpx;border:2rpx solid var(--border);border-radius:10rpx;text-align:center;font-size:30rpx;font-weight:600;color:#0f766e;"
              value="{{item.countQty}}" data-gidx="{{gIdx}}" data-iidx="{{iIdx}}" bindinput="onQtyInput" />
            <text style="font-size:22rpx;color:var(--text-2);width:40rpx;">{{item.unit}}</text>
          </view>
        </view>
        <!-- 第二行：小计 + 备注 -->
        <view style="display:flex;align-items:center;margin-top:8rpx;">
          <view wx:if="{{item.countQty > 0}}" style="font-size:24rpx;color:#e53e3e;font-weight:600;">
            小计：¥{{item.subtotal}}（{{item.price}} × {{item.countQty}}）
          </view>
          <input style="flex:1;margin-left:auto;width:280rpx;height:56rpx;border:1rpx solid var(--border);border-radius:8rpx;padding:0 16rpx;font-size:24rpx;color:var(--text-2);"
            placeholder="备注" value="{{item.remark}}" data-gidx="{{gIdx}}" data-iidx="{{iIdx}}" bindinput="onRemarkInput" />
        </view>
      </view>
    </view>

    <!-- 盘点备注 -->
    <view class="card">
      <view style="font-size:26rpx;color:var(--text-2);margin-bottom:10rpx;">盘点备注</view>
      <textarea class="form-textarea" placeholder="整体盘点说明（可选）" value="{{checkRemark}}" bindinput="onCheckRemarkInput" />
    </view>

    <!-- 总价汇总 -->
    <view class="card" style="display:flex;justify-content:space-between;align-items:center;">
      <view style="font-size:28rpx;font-weight:600;">库存总价值</view>
      <view style="font-size:40rpx;font-weight:800;color:#e53e3e;">¥{{checkTotalValue}}</view>
    </view>

    <!-- 底部操作栏 -->
    <view style="position:fixed;bottom:0;left:0;right:0;display:flex;gap:16rpx;padding:20rpx 24rpx;background:#fff;box-shadow:0 -2rpx 12rpx rgba(15,23,42,.08);z-index:100;">
      <view class="btn btn-outline" style="flex:1;" bindtap="cancelCheck">取消</view>
      <view class="btn" style="flex:2;background:#0f766e;color:#fff;" bindtap="saveCheck">保存盘点</view>
    </view>
    <view style="height:120rpx;"></view>
  </block>

  <!-- ========== 模式：查看详情 ========== -->
  <block wx:if="{{mode === 'detail'}}">
    <view style="background:#0f766e;color:#fff;padding:24rpx 32rpx;margin-bottom:16rpx;">
      <view style="display:flex;justify-content:space-between;align-items:center;">
        <view>
          <view style="font-size:30rpx;font-weight:700;">{{detailInv.monthLabel}}盘点详情</view>
          <view style="font-size:24rpx;opacity:.8;margin-top:4rpx;">有库存 {{detailInv.filledCount}}/{{detailInv.totalItems}} 项</view>
        </view>
        <view style="text-align:right;">
          <view style="font-size:22rpx;opacity:.8;">库存总价值</view>
          <view style="font-size:36rpx;font-weight:700;">¥{{detailTotalValue}}</view>
        </view>
      </view>
    </view>

    <!-- 导出按钮 -->
    <view style="padding:0 24rpx 16rpx;">
      <view class="btn btn-block" style="background:#0f766e;color:#fff;" bindtap="exportInventoryReport">📥 导出盘点报表(Excel)</view>
    </view>

    <!-- 备注 -->
    <view class="card" wx:if="{{detailInv.remark}}">
      <view style="font-size:26rpx;color:var(--text-2);margin-bottom:8rpx;">盘点备注</view>
      <view style="font-size:28rpx;">{{detailInv.remark}}</view>
    </view>

    <!-- 货品明细 -->
    <view wx:for="{{detailGroups}}" wx:for-item="group" wx:key="catId" class="card">
      <view style="display:flex;align-items:center;margin-bottom:12rpx;">
        <text style="font-size:32rpx;margin-right:8rpx;">{{group.icon}}</text>
        <text style="font-size:28rpx;font-weight:700;color:#0f766e;">{{group.catName}}</text>
      </view>
      <!-- 表头 -->
      <view style="display:flex;padding:8rpx 0;border-bottom:2rpx solid #e2e8f0;font-size:22rpx;color:#94a3b8;font-weight:600;">
        <view style="flex:1;">商品</view>
        <view style="width:100rpx;text-align:center;">单价</view>
        <view style="width:80rpx;text-align:center;">数量</view>
        <view style="width:120rpx;text-align:right;">金额</view>
      </view>
      <view wx:for="{{group.items}}" wx:for-item="item" wx:key="goodsId"
        style="display:flex;padding:12rpx 0;border-bottom:1rpx solid var(--border);align-items:center;">
        <view style="flex:1;overflow:hidden;">
          <view style="font-weight:600;font-size:26rpx;">{{item.name}}</view>
          <view style="font-size:20rpx;color:var(--text-3);">{{item.code}} · {{item.specWeight || '-'}}</view>
          <view style="font-size:20rpx;color:#d97706;" wx:if="{{item.remark}}">{{item.remark}}</view>
        </view>
        <view style="width:100rpx;text-align:center;font-size:24rpx;color:var(--text-2);">¥{{item.price}}</view>
        <view style="width:80rpx;text-align:center;">
          <text style="font-size:28rpx;font-weight:700;color:{{item.countQty > 0 ? '#0f766e' : '#cbd5e1'}};">{{item.countQty}}</text>
          <text style="font-size:20rpx;color:var(--text-2);">{{item.unit}}</text>
        </view>
        <view style="width:120rpx;text-align:right;font-size:26rpx;font-weight:700;color:{{item.countQty > 0 ? '#e53e3e' : '#cbd5e1'}};">¥{{item.subtotal}}</view>
      </view>
    </view>

    <!-- 总计 -->
    <view class="card" style="display:flex;justify-content:space-between;align-items:center;">
      <view style="font-size:30rpx;font-weight:700;">总计</view>
      <view style="font-size:40rpx;font-weight:800;color:#e53e3e;">¥{{detailTotalValue}}</view>
    </view>

    <view style="padding:16rpx 24rpx 40rpx;">
      <view class="btn btn-block btn-outline" bindtap="backToOverview">返回</view>
    </view>
  </block>

</view>
