<view class="fix-top"></view>

<view class="card" style="background:linear-gradient(135deg,#ea580c,#f97316);color:#fff;border-radius:24rpx;">
  <view style="font-size:36rpx;font-weight:700;">订单管理</view>
  <view style="font-size:24rpx;opacity:.85;margin-top:8rpx;">接单 · 发货 · 跟踪订单状态</view>
</view>

<!-- 搜索栏 -->
<view class="search-bar">
  <text class="search-ico">🔍</text>
  <input placeholder="搜索订单号、店铺名或货品" value="{{keyword}}" bindinput="onSearch" />
  <text style="font-size:26rpx;color:#ea580c;font-weight:600;flex-shrink:0;margin-left:16rpx;" bindtap="exportOrders">📥导出</text>
</view>

<!-- 状态筛选 -->
<view class="cat-bar">
  <view class="cat-tag {{filterStatus === '' ? 'active' : ''}}" bindtap="filterStatus" data-status="">全部</view>
  <view class="cat-tag {{filterStatus === 'pending' ? 'active' : ''}}" bindtap="filterStatus" data-status="pending">待接单</view>
  <view class="cat-tag {{filterStatus === 'accepted' ? 'active' : ''}}" bindtap="filterStatus" data-status="accepted">已接单</view>
  <view class="cat-tag {{filterStatus === 'shipped' ? 'active' : ''}}" bindtap="filterStatus" data-status="shipped">配送中</view>
  <view class="cat-tag {{filterStatus === 'partial' ? 'active' : ''}}" bindtap="filterStatus" data-status="partial">部分收货</view>
  <view class="cat-tag {{filterStatus === 'received' ? 'active' : ''}}" bindtap="filterStatus" data-status="received">已收货</view>
</view>

<!-- 订单列表 -->
<view class="card" wx:if="{{filteredOrders.length > 0}}">
  <view wx:for="{{filteredOrders}}" wx:key="_id" class="order-row">
    <view class="order-row-top" bindtap="viewDetail" data-id="{{item._id}}">
      <view class="order-row-no">{{item.no}}</view>
      <view class="tag tag-{{item.status}}">{{statusLabels[item.status]}}</view>
    </view>
    <view class="order-row-store" bindtap="viewDetail" data-id="{{item._id}}">{{item.storeName}}</view>
    <view class="order-row-meta" bindtap="viewDetail" data-id="{{item._id}}">
      <view class="order-row-items">{{item.items.length}}种货品 · {{item.createTime}}</view>
      <view class="order-row-total">¥{{item.total}}</view>
    </view>
    <!-- 发货图片预览（若有） -->
    <view wx:if="{{item.shipImage}}" class="ship-preview" bindtap="viewDetail" data-id="{{item._id}}">
      <image src="{{item.shipImage}}" mode="aspectFill" class="ship-thumb" />
      <text class="ship-label">📸 发货凭证</text>
    </view>
    <!-- 操作按钮 -->
    <view wx:if="{{item.status === 'pending' || item.status === 'accepted'}}" class="order-actions">
      <view wx:if="{{item.status === 'pending'}}" class="btn btn-sm btn-danger" bindtap="rejectOrder" data-id="{{item._id}}">退单</view>
      <view wx:if="{{item.status === 'pending'}}" class="btn btn-sm btn-success" bindtap="acceptOrder" data-id="{{item._id}}">接单</view>
      <view wx:if="{{item.status === 'accepted'}}" class="btn btn-sm btn-primary" style="background:#ea580c;" bindtap="openShipModal" data-id="{{item._id}}">📷 发货</view>
    </view>
  </view>
</view>

<view wx:else class="card">
  <view class="empty-block">
    <view class="empty-ico">📋</view>
    <view>{{keyword ? '未找到匹配的订单' : '暂无订单'}}</view>
  </view>
</view>

<!-- 加载更多 -->
<view wx:if="{{loadingMore}}" class="load-more">加载中...</view>
<view wx:elif="{{!hasMore && filteredOrders.length > 0}}" class="load-more load-end">— 已加载全部 —</view>

<!-- 发货弹窗 -->
<view wx:if="{{showShipModal}}" class="modal-mask">
  <view class="modal-overlay" bindtap="closeShipModal"></view>
  <view class="modal-body">
    <view class="modal-title">确认发货</view>

    <!-- 货品清单 -->
    <view style="margin-bottom:20rpx;" wx:if="{{shipOrder}}">
      <view style="font-size:26rpx;color:#64748b;margin-bottom:12rpx;">订单号：{{shipOrder.no}}</view>
      <view wx:for="{{shipOrder.items}}" wx:key="goodsId" wx:for-item="oi" style="display:flex;justify-content:space-between;padding:8rpx 0;font-size:26rpx;">
        <text>{{oi.name}} × {{oi.qty}}{{oi.unit}}</text>
        <text style="color:#ef4444;">¥{{oi.amount}}</text>
      </view>
    </view>

    <!-- 发货图片上传 -->
    <view class="form-group">
      <view class="form-label">发货凭证图片 <text style="color:#ef4444;">*</text></view>
      <view wx:if="{{shipImage}}" style="position:relative;display:inline-block;">
        <image src="{{shipImage}}" mode="aspectFill" style="width:200rpx;height:200rpx;border-radius:12rpx;" />
        <view style="position:absolute;top:-12rpx;right:-12rpx;width:40rpx;height:40rpx;border-radius:50%;background:#ef4444;color:#fff;display:flex;align-items:center;justify-content:center;font-size:24rpx;"
          bindtap="onRemoveShipImage">✕</view>
      </view>
      <view wx:else style="width:200rpx;height:200rpx;border:3rpx dashed #f97316;border-radius:12rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#ea580c;background:#fff7ed;"
        bindtap="onChooseShipImage">
        <view style="font-size:48rpx;">📸</view>
        <view style="font-size:24rpx;margin-top:8rpx;">拍照 / 相册</view>
        <view style="font-size:20rpx;color:#fdba74;margin-top:4rpx;">上传发货凭证</view>
      </view>
    </view>

    <view class="modal-actions">
      <view class="btn btn-outline" bindtap="closeShipModal">取消</view>
      <view class="btn" style="background:#ea580c;color:#fff;" bindtap="confirmShip">{{shipUploading ? '上传中...' : '确认发货'}}</view>
    </view>
  </view>
</view>

<!-- 订单详情弹窗 -->
<view wx:if="{{showDetail}}" class="modal-mask">
  <view class="modal-overlay" bindtap="closeDetail"></view>
  <view class="modal-body">
    <view class="modal-title">订单详情</view>
    <view style="margin-bottom:16rpx;">
      <view style="display:flex;justify-content:space-between;margin-bottom:8rpx;">
        <text style="color:#64748b;font-size:26rpx;">订单号</text>
        <text style="font-weight:600;">{{detailOrder.no}}</text>
      </view>
      <view style="display:flex;justify-content:space-between;margin-bottom:8rpx;">
        <text style="color:#64748b;font-size:26rpx;">店铺</text>
        <text>{{detailOrder.storeName}}</text>
      </view>
      <view style="display:flex;justify-content:space-between;margin-bottom:8rpx;">
        <text style="color:#64748b;font-size:26rpx;">状态</text>
        <view class="tag tag-{{detailOrder.status}}">{{statusLabels[detailOrder.status]}}</view>
      </view>
      <view style="display:flex;justify-content:space-between;margin-bottom:8rpx;">
        <text style="color:#64748b;font-size:26rpx;">下单时间</text>
        <text style="font-size:26rpx;">{{detailOrder.createTime}}</text>
      </view>
      <view wx:if="{{detailOrder.shipTime}}" style="display:flex;justify-content:space-between;margin-bottom:8rpx;">
        <text style="color:#64748b;font-size:26rpx;">发货时间</text>
        <text style="font-size:26rpx;color:#ea580c;">{{detailOrder.shipTime}}</text>
      </view>
      <view wx:if="{{detailOrder.remark}}" style="display:flex;justify-content:space-between;margin-bottom:8rpx;">
        <text style="color:#64748b;font-size:26rpx;">备注</text>
        <text style="font-size:26rpx;">{{detailOrder.remark}}</text>
      </view>
    </view>

    <!-- 发货凭证图片 -->
    <view wx:if="{{detailOrder.shipImage}}" style="margin-bottom:16rpx;">
      <view style="font-size:26rpx;color:#64748b;margin-bottom:8rpx;">发货凭证</view>
      <image src="{{detailOrder.shipImage}}" mode="widthFix" style="width:100%;border-radius:12rpx;" />
    </view>

    <view style="border-top:1rpx solid #e2e8f0;padding-top:16rpx;margin-bottom:8rpx;font-weight:600;font-size:28rpx;">货品明细</view>
    <view wx:for="{{detailOrder.items}}" wx:key="goodsId" style="display:flex;justify-content:space-between;padding:12rpx 0;font-size:26rpx;">
      <text style="flex:1;">{{item.name}}</text>
      <text style="color:#64748b;margin:0 16rpx;">{{item.qty}}{{item.unit}} × ¥{{item.price}}</text>
      <text style="font-weight:600;color:#ef4444;">¥{{item.amount}}</text>
    </view>
    <view style="display:flex;justify-content:space-between;padding-top:16rpx;border-top:1rpx solid #e2e8f0;margin-top:8rpx;">
      <text style="font-weight:700;">合计</text>
      <text style="font-weight:700;color:#ef4444;font-size:32rpx;">¥{{detailOrder.total}}</text>
    </view>
    <view class="modal-actions">
      <view class="btn btn-outline" bindtap="closeDetail">关闭</view>
    </view>
  </view>
</view>

<tabbar current="orders" />
