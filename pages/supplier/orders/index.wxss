/* 订单行 */
.order-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}
.order-row:last-child {
  border-bottom: none;
}
.order-row-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}
.order-row-no {
  font-weight: 700;
  font-size: 28rpx;
}
.order-row-store {
  font-size: 24rpx;
  color: #94a3b8;
}
.order-row-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}
.order-row-items {
  font-size: 24rpx;
  color: #94a3b8;
}
.order-row-total {
  font-weight: 700;
  color: #ef4444;
  font-size: 30rpx;
}
.order-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  justify-content: flex-end;
}

/* 发货图片预览 */
.ship-preview {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #fef3c7;
  border-radius: 10rpx;
}
.ship-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 8rpx;
  border: 2rpx solid #f59e0b;
}
.ship-label {
  font-size: 22rpx;
  color: #92400e;
  font-weight: 600;
}
