<view class="fix-top"></view>

<!-- 顶部供货商卡片 -->
<view class="card" style="background:linear-gradient(135deg,#ea580c,#f97316);color:#fff;border-radius:24rpx;">
  <view style="font-size:36rpx;font-weight:700;">{{supplier.name || '供货商'}}</view>
  <view style="font-size:24rpx;opacity:.85;margin-top:8rpx;">{{supplier.contact || ''}} · {{supplier.phone || ''}}</view>
  <view style="display:flex;gap:12rpx;margin-top:12rpx;">
    <view style="padding:4rpx 16rpx;border-radius:8rpx;font-size:22rpx;background:rgba(255,255,255,.2);">结算：{{settlementName}}</view>
    <view wx:if="{{couponText}}" style="padding:4rpx 16rpx;border-radius:8rpx;font-size:22rpx;background:rgba(255,255,255,.2);">🎫 {{couponText}}</view>
    <view wx:if="{{supplier.minOrderAmount > 0}}" style="padding:4rpx 16rpx;border-radius:8rpx;font-size:22rpx;background:rgba(255,255,255,.2);">起送¥{{supplier.minOrderAmount}}</view>
  </view>
</view>

<!-- 订单通知订阅 -->
<view class="card" style="display:flex;align-items:center;padding:24rpx 28rpx;">
  <view style="flex:1;">
    <view style="font-size:28rpx;font-weight:600;color:#1e293b;">订单通知</view>
    <view style="font-size:24rpx;color:#94a3b8;margin-top:4rpx;">开启后，店长下单时将收到微信消息提醒</view>
  </view>
  <view bindtap="onSubscribeNotify" style="padding:12rpx 32rpx;border-radius:24rpx;font-size:26rpx;font-weight:600;color:#fff;background:#ea580c;">
    {{notifySubscribed ? '已开启' : '开启通知'}}
  </view>
</view>

<!-- 统计行 -->
<view class="stat-row card">
  <view class="stat-cell" bindtap="goTo" data-url="/pages/supplier/orders/index">
    <view class="stat-num" style="color:#ea580c;">{{stats.orderCount}}</view>
    <view class="stat-label">订单总数</view>
  </view>
  <view class="stat-cell" bindtap="goTo" data-url="/pages/supplier/orders/index">
    <view class="stat-num" style="color:#f59e0b;">{{stats.pendingCount}}</view>
    <view class="stat-label">待接单</view>
  </view>
  <view class="stat-cell" bindtap="goTo" data-url="/pages/supplier/orders/index">
    <view class="stat-num" style="color:#8b5cf6;">{{stats.shippedCount}}</view>
    <view class="stat-label">配送中</view>
  </view>
  <view class="stat-cell" bindtap="goTo" data-url="/pages/supplier/reports/index">
    <view class="stat-num" style="color:#10b981;">¥{{stats.monthSales}}</view>
    <view class="stat-label">本月销售</view>
  </view>
</view>

<!-- 待处理订单提醒 -->
<view wx:if="{{stats.pendingCount > 0}}" class="card" style="background:linear-gradient(135deg,#fef3c7,#fde68a);border:none;" bindtap="goTo" data-url="/pages/supplier/orders/index">
  <view style="display:flex;align-items:center;">
    <view style="font-size:44rpx;margin-right:16rpx;">⚠️</view>
    <view style="flex:1;">
      <view style="font-size:30rpx;font-weight:700;color:#92400e;">您有 {{stats.pendingCount}} 个待接单订单</view>
      <view style="font-size:24rpx;color:#b45309;margin-top:4rpx;">点击查看并处理 ›</view>
    </view>
  </view>
</view>

<!-- 快捷操作 -->
<view class="card">
  <view style="display:flex;gap:20rpx;">
    <view style="flex:1;background:#fff7ed;border-radius:16rpx;padding:28rpx 0;text-align:center;" bindtap="goTo" data-url="/pages/supplier/orders/index">
      <view style="font-size:44rpx;">📦</view>
      <view style="font-size:26rpx;font-weight:600;color:#ea580c;margin-top:8rpx;">查看订单</view>
    </view>
    <view style="flex:1;background:#fff7ed;border-radius:16rpx;padding:28rpx 0;text-align:center;" bindtap="goTo" data-url="/pages/supplier/reports/index">
      <view style="font-size:44rpx;">📊</view>
      <view style="font-size:26rpx;font-weight:600;color:#ea580c;margin-top:8rpx;">销售报表</view>
    </view>
  </view>
</view>

<!-- 最近订单 -->
<view class="card">
  <view style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16rpx;" bindtap="goTo" data-url="/pages/supplier/orders/index">
    <text style="font-size:30rpx;font-weight:700;">最近订单</text>
    <text style="color:#64748b;font-size:24rpx;">全部 ›</text>
  </view>
  <view wx:if="{{recentOrders.length === 0}}" class="empty-block">
    <view class="empty-ico">📋</view>
    <view>暂无订单</view>
  </view>
  <view wx:for="{{recentOrders}}" wx:key="_id" style="display:flex;align-items:center;padding:16rpx 0;border-bottom:1rpx solid #f1f5f9;">
    <view style="flex:1;">
      <view style="font-weight:600;font-size:28rpx;">{{item.no}}</view>
      <view style="font-size:24rpx;color:#94a3b8;margin-top:4rpx;">{{item.storeName}} · {{item.items.length}}种货品</view>
    </view>
    <view style="text-align:right;">
      <view style="font-weight:700;color:#ef4444;">¥{{item.total}}</view>
      <view class="tag tag-{{item.status}}" style="margin-top:4rpx;">{{statusLabels[item.status]}}</view>
    </view>
  </view>
</view>

<tabbar current="dashboard" />
